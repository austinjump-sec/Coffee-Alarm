{
  "expo": {
    "name": "CoffeeAlarm",
    "slug": "CoffeeAlarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "coffeealarm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.coffeealarm.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png",
        "backgroundImage": "./assets/images/logo.png",
        "monochromeImage": "./assets/images/logo.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.coffeealarm.app"
    },
    "predictiveBackGestureEnabled": false,
    "extra": {
      "eas": {
        "projectId": "75b99e70-5f01-4cde-aabd-0d30a5e238fa"
      }
    },
    "plugins": [
      "expo-audio",
      "expo-alarm-module"
    ]
  },
  "web": {
    "output": "static",
    "favicon": "./assets/images/logo.png"
  },
  "plugins": [
    [
      "expo-audio",
      {
        "enableBackgroundPlayback": true
      }
    ],
    "expo-router",
    "expo-notifications",
    {
      "sounds": [
        "./assets/sounds/default.wav",
        "./assets/sounds/beep.wav"
      ]
    },
    [
      "expo-splash-screen",
      {
        "backgroundColor": "#208AEF",
        "image": "./assets/images/logo.png",
        "imageWidth": 76
      }
    ]
  ],
  "experiments": {
    "typedRoutes": true,
    "reactCompiler": true
  }
}
