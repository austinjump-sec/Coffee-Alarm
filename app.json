{
  "expo": {
    "name": "CoffeeAlarm",
    "slug": "coffee-alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo2.png",
    "scheme": "coffeealarm",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo2.png",
      "bundleIdentifier": "com.coffeealarm.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo2.png",
        "backgroundImage": "./assets/images/logo2.png",
        "monochromeImage": "./assets/images/logo2.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.coffeealarm.app"
    },
    "predictiveBackGestureEnabled": false,
    "extra": {
      "eas": {
        "projectId": "254df31d-925e-4800-8798-86d0b6f8a904"
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ],
      "expo-alarm-module",
      "expo-router",
      [
        "expo-notifications",
        {
      
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo2.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo2.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}

