<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required for HTTP requests to the ESP32 and mDNS service discovery. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Required by react-native-alarm-manager for scheduled wake-ups. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Android 13+ notification permission for alarm notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        This manifest is intended to be merged into the React Native Android app
        generated for this project. The generated application activity and
        react-native-alarm-manager components should remain in that project’s
        manifest; do not duplicate them here unless the library documentation
        requires explicit receiver/service declarations.
    -->
    <application
        android:usesCleartextTraffic="true"
        android:label="Coffee Alarm"
        android:allowBackup="true"
        android:supportsRtl="true" />

</manifest>
